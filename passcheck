import sys
import string

def main():
    if len(sys.argv) != 2:
       print("パスワードを1つ指定してください", file=sys.stderr)
       return 1

    password = sys.argv[1]

    if len(password) < 8:
       print("パスワードは8文字以上にしてください", file=sys.stderr)
       return 1

    score = 0

    if any(c.islower() for c in password):
        score += 1

    if any(c.isupper() for c in password):
        score += 1

    if any(c.isdigit() for c in password):
        score += 1

    if any(c in string.punctuation for c in password):
        score += 1

    if score == 4:
        print("強い")
    elif score >= 2:
        print("普通")
    else:
        print("弱い")

    return 0


if __name__ == "__main__":
    sys.exit(main())
